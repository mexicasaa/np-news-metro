{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/sitemap",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/sitemaps",
      "destination": "/sitemap_index.xml",
      "permanent": true
    },
    {
      "source": "/sitemaps.xml",
      "destination": "/sitemap_index.xml",
      "permanent": true
    },
    {
      "source": "/sitemap_index",
      "destination": "/sitemap_index.xml",
      "permanent": true
    },
    {
      "source": "/sitemap-index",
      "destination": "/sitemap_index.xml",
      "permanent": true
    },
    {
      "source": "/sitemap-index.xml",
      "destination": "/sitemap_index.xml",
      "permanent": true
    },
    {
      "source": "/news-sitemap",
      "destination": "/news-sitemap.xml",
      "permanent": true
    },
    {
      "source": "/news_sitemap.xml",
      "destination": "/news-sitemap.xml",
      "permanent": true
    },
    {
      "source": "/image-sitemap",
      "destination": "/image-sitemap.xml",
      "permanent": true
    },
    {
      "source": "/image_sitemap.xml",
      "destination": "/image-sitemap.xml",
      "permanent": true
    },
    {
      "source": "/video-sitemap",
      "destination": "/video-sitemap.xml",
      "permanent": true
    },
    {
      "source": "/video_sitemap.xml",
      "destination": "/video-sitemap.xml",
      "permanent": true
    },
    {
      "source": "/rss",
      "destination": "/rss.xml",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/rss.xml",
      "permanent": true
    },
    {
      "source": "/feed.xml",
      "destination": "/rss.xml",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/image/:path*",
      "destination": "/api/image?path=:path*"
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/api/sitemap_index"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/news-sitemap.xml",
      "destination": "/api/news-sitemap"
    },
    {
      "source": "/image-sitemap.xml",
      "destination": "/api/image-sitemap"
    },
    {
      "source": "/video-sitemap.xml",
      "destination": "/api/video-sitemap"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/rss"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/BingSiteAuth.xml",
      "destination": "/api/BingSiteAuth"
    },
    {
      "source": "/968b4404627f469a8e29b9a607c4b1e7.txt",
      "destination": "/api/indexnow-key"
    },
    {
      "source": "/indexnow",
      "destination": "/api/indexnow"
    },
    {
      "source": "/category/:category",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?i)(googlebot|bingbot|yandex|duckduckbot|baiduspider|facebookexternalhit|facebot|facebookcatalog|whatsapp|twitterbot|xbot|telegrambot|linkedinbot|discordbot|slackbot|applebot|skypeuripreview|snapchat|pinterest|google-inspectiontool|storebot-google|mediapartners-google|feedfetcher-google).*"
        }
      ],
      "destination": "/api/share?category=:category"
    },
    {
      "source": "/category/:category/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?i)(googlebot|bingbot|yandex|duckduckbot|baiduspider|facebookexternalhit|facebot|facebookcatalog|whatsapp|twitterbot|xbot|telegrambot|linkedinbot|discordbot|slackbot|applebot|skypeuripreview|snapchat|pinterest|google-inspectiontool|storebot-google|mediapartners-google|feedfetcher-google).*"
        }
      ],
      "destination": "/api/share?category=:category"
    },
    {
      "source": "/videos/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?i)(googlebot|bingbot|yandex|duckduckbot|baiduspider|facebookexternalhit|facebot|facebookcatalog|whatsapp|twitterbot|xbot|telegrambot|linkedinbot|discordbot|slackbot|applebot|skypeuripreview|snapchat|pinterest|google-inspectiontool|storebot-google|mediapartners-google|feedfetcher-google).*"
        }
      ],
      "destination": "/api/share?category=videos&slug=:slug"
    },
    {
      "source": "/videos/:slug/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?i)(googlebot|bingbot|yandex|duckduckbot|baiduspider|facebookexternalhit|facebot|facebookcatalog|whatsapp|twitterbot|xbot|telegrambot|linkedinbot|discordbot|slackbot|applebot|skypeuripreview|snapchat|pinterest|google-inspectiontool|storebot-google|mediapartners-google|feedfetcher-google).*"
        }
      ],
      "destination": "/api/share?category=videos&slug=:slug"
    },
    {
      "source": "/:category/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?i)(googlebot|bingbot|yandex|duckduckbot|baiduspider|facebookexternalhit|facebot|facebookcatalog|whatsapp|twitterbot|xbot|telegrambot|linkedinbot|discordbot|slackbot|applebot|skypeuripreview|snapchat|pinterest|google-inspectiontool|storebot-google|mediapartners-google|feedfetcher-google).*"
        }
      ],
      "destination": "/api/share?category=:category&slug=:slug"
    },
    {
      "source": "/:category/:slug/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?i)(googlebot|bingbot|yandex|duckduckbot|baiduspider|facebookexternalhit|facebot|facebookcatalog|whatsapp|twitterbot|xbot|telegrambot|linkedinbot|discordbot|slackbot|applebot|skypeuripreview|snapchat|pinterest|google-inspectiontool|storebot-google|mediapartners-google|feedfetcher-google).*"
        }
      ],
      "destination": "/api/share?category=:category&slug=:slug"
    },
    {
      "source": "/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?i)(googlebot|bingbot|yandex|duckduckbot|baiduspider|facebookexternalhit|facebot|facebookcatalog|whatsapp|twitterbot|xbot|telegrambot|linkedinbot|discordbot|slackbot|applebot|skypeuripreview|snapchat|pinterest|google-inspectiontool|storebot-google|mediapartners-google|feedfetcher-google).*"
        }
      ],
      "destination": "/api/share?slug=:slug"
    },
    {
      "source": "/:slug/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?i)(googlebot|bingbot|yandex|duckduckbot|baiduspider|facebookexternalhit|facebot|facebookcatalog|whatsapp|twitterbot|xbot|telegrambot|linkedinbot|discordbot|slackbot|applebot|skypeuripreview|snapchat|pinterest|google-inspectiontool|storebot-google|mediapartners-google|feedfetcher-google).*"
        }
      ],
      "destination": "/api/share?slug=:slug"
    },
    {
      "source": "/((?!api/|assets/|uploads/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/sitemap\\.xsl",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/xsl; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/ads\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/(.*)\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}