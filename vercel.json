{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/sitemap",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/api/rss",
      "destination": "/rss.xml"
    },
    {
      "source": "/api/news-sitemap",
      "destination": "/news-sitemap.xml"
    },
    {
      "source": "/api/image-sitemap",
      "destination": "/image-sitemap.xml"
    },
    {
      "source": "/api/video-sitemap",
      "destination": "/video-sitemap.xml"
    },
    {
      "source": "/api/robots",
      "destination": "/robots.txt"
    },
    {
      "source": "/api/share",
      "destination": "/api/share.js"
    },
    {
      "source": "/((?!api/|assets/|uploads/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/sitemap\\.xsl",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/xsl; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/ads\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
