# Node dependencies
node_modules/
dist/
dist-ssr/

# Zip Archives (Excluding all ZIP files as requested)
*.zip
**/*.zip

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

